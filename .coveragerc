[run]
branch = True
parallel = True
patch = subprocess
relative_files = True
source =
    libexec
    src/agentic_praxis_grimoire

[paths]
source =
    libexec
    */public-source/libexec
    src/agentic_praxis_grimoire
    */public-source/src/agentic_praxis_grimoire

[report]
show_missing = True
skip_empty = False

[json]
pretty_print = True
