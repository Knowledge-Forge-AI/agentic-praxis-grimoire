{
  "compilerOptions": {
    "strict": true,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "checkJs": true,
    "jsx": "preserve",
    "noEmit": true,
    "rootDir": "src"
  },
  "include": [
    "src/core",
    "src/modules",
    "src/declarations",
    "src/ui",
    "src/checked"
  ]
}
