    "expected": "reject-unknown-validator"
  },
  {
    "case_id": "non-positive-limit",
    "kind": "profile-entry",
    "entry": {"name": "APG98_ZERO", "validator": "raw_safe", "max_bytes": 0, "required": false},
    "expected": "reject-max-bytes"
  },
  {
    "case_id": "invalid-default",
    "kind": "profile-entry",
    "entry": {"name": "APG98_BAD_DEFAULT", "validator": "port", "max_bytes": 5, "required": false, "default": "65536"},
    "expected": "reject-default-validator"
  },
  {
    "case_id": "control-default",
    "kind": "profile-entry",
    "entry": {"name": "APG98_CONTROL", "validator": "raw_safe", "max_bytes": 32, "required": false, "default": "fixture\nvalue"},
