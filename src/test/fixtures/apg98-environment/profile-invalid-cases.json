    "expected": "reject-duplicate-key"
  },
  {
    "case_id": "duplicate-name",
    "kind": "profile-entry",
    "entries": [
      {"name": "APG98_DUPLICATE", "validator": "token", "max_bytes": 32, "required": false},
      {"name": "APG98_DUPLICATE", "validator": "token", "max_bytes": 32, "required": false}
    ],
    "expected": "reject-duplicate-name"
  },
  {
    "case_id": "wildcard-name",
