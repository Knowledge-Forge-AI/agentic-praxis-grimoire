#!/usr/bin/env python3
"""Capture a prospective APGR worktree into a clean disposable repository."""

from pathlib import Path
import sys


command = Path(__file__).resolve(strict=True)
root = command.parent.parent
helper_directory = root / "libexec"
helper = helper_directory / "apg_source_capture.py"
if (
    command.parent.name != "bin"
    or not helper_directory.is_dir()
    or helper.is_symlink()
    or not helper.is_file()
):
    print("apg-capture-source: installed command layout is invalid", file=sys.stderr)
    raise SystemExit(1)

sys.path.insert(0, str(helper_directory))
from apg_source_capture import main  # noqa: E402


raise SystemExit(main())
