#!/usr/bin/env bash
set -euo pipefail

source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir=$(CDPATH= cd -P -- "$(dirname -- "$source")" && pwd -P)
  source=$(readlink -- "$source")
  [ "${source#/}" = "$source" ] && source="$dir/$source"
done
root=$(CDPATH= cd -P -- "$(dirname -- "$source")/.." && pwd -P)
exec python3 -B "$root/libexec/controller_generation_bootstrap.py" ownership "$@"
