#!/usr/bin/env python3
"""Validate the APG v0.11 roadmap closure governance ledgers and contracts."""

from pathlib import Path
import sys

sys.dont_write_bytecode = True

command = Path(__file__).resolve(strict=True)
root = command.parent.parent
helper_directory = root / "libexec"
helper = helper_directory / "apg_roadmap_closure.py"

if (
    command.parent.name != "bin"
    or not helper_directory.is_dir()
    or helper_directory.is_symlink()
    or not helper.is_file()
    or helper.is_symlink()
):
    print(
        "apg-check-roadmap-closure: installed APG command layout is invalid; restore the APG checkout",
        file=sys.stderr,
    )
    raise SystemExit(2)

sys.path.insert(0, str(helper_directory))
from apg_roadmap_closure import main

raise SystemExit(main(sys.argv[1:]))
